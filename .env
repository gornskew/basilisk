# Docker Compose Environment Variables
# Generated by ./generate-env.sh

# User paths
USER_HOME=/home/dcooper8
PROJECTS_DIR=/home/dcooper8/projects

# User/Group IDs
HOST_USER_UID=1000
DOCKER_GROUP_ID=989

# Image and Container names
CURRENT_BRANCH=devo
EMACS_IMAGE_BRANCH=devo
EMACS_IMAGE_BASE=skewed-emacs
EMACS_IMAGE_VARIANT=full
GENDL_IMAGE_BRANCH=devo
GENDL_IMAGE_BASE=gendl

# Instance identity (empty = the historical single-stack behaviour)
BASILISK_INSTANCE=
BASILISK_PREFIX=
BASILISK_PORT_OFFSET=0

# Network name (one bridge per instance)
DOCKER_NETWORK_NAME=skewed-network

# Published host ports, offset by BASILISK_PORT_OFFSET
TTYD_HOST_PORT=6942
GENDL_CCL_HOST_PORT=19080
GENDL_SBCL_HOST_PORT=29080
CYCLOPS_HOST_PORT=19069
CYCLOPS_UTILITY_HOST_PORT=19191
GDL_SMP_HOST_PORT=9098
GDL_NON_SMP_HOST_PORT=9088

TERM=xterm-256color
COLORTERM=truecolor



# Timezone (detected from host)
TZ=America/New_York

