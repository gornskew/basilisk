# ==============================================================================
# .dockerignore - Controls what gets sent to Docker build context
# NOTE: Intentionally mirrors .gitignore for consistency
# ==============================================================================

# ==============================================================================
# Emacs temporary/backup files
# ==============================================================================
*~
.#*
**/#*#
*.elc

# ==============================================================================
# Log files
# ==============================================================================
*.log
*.log*

# ==============================================================================
# Emacs user directories (regenerated, user-specific)
# ==============================================================================
# ==============================================================================
.authinfo
.authinfo.gpg
.env
.tokens/
*token*

*-stack-compose.yml

# Development overlay files (local, not committed)

*-overlay.yml

*-dev-overlay.yml

# ==============================================================================
# Generated MCP configs
# ==============================================================================

mcp/*mcp*
!mcp/merge-mcp-configs.el
!mcp/mcp-*
# Written back into this clone by every `./basilisk up' (the merge output
# for Claude Desktop).  It was ALSO committed, and a tracked file ignores
# .gitignore entirely -- so every start left the clone dirty, and
# `repos deploy' then refused to pull basilisk on sally and shelly,
# silently, for as long as that lasted.  Untracked 2026-08-16; if it ever
# needs to be tracked again, it wants a .example suffix and a generated
# sibling, not a rule that cannot fire.
mcp/claude_desktop_config.json
mcp/opening-prompt-local.md

# ==============================================================================
# Per-host state, written by <host>-stack/install into THIS clone
# ==============================================================================
# host.env carries the image-variant pin for the machine this clone runs
# on.  Tracking it puts one ship's pin in every ship's repo: it arrived
# here saying EMACS_IMAGE_VARIANT=full from narad-stack/install, so a
# clone pinned to lite gets a heavy Captain back on the next pull.
systemd/host.env

# Host overlay yard output, copied in by <host>-stack/install and
# re-copied by every `./basilisk up'.  The UNPREFIXED
# generated/services-generated.el is the base file and stays tracked --
# it is the yard's own output and every ship needs it.  The <host>-stack-
# prefixed ones belong to whichever machine ran install last, and get
# rewritten under you on every start, so tracking them just strands one
# ship's roster in every ship's repo.
generated/*-stack-services-generated.el

# ==============================================================================
# Build artifacts & caches
# ==============================================================================
# (.git/ was listed here and removed 2026-08-16: git never tracks its own
# directory, so the rule could only ever be noise.  It matters for the
# .dockerignore this file mirrors -- keep it THERE, not here.)
tmp/
