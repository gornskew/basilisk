#!/bin/bash
#
# Install script for cloud-stack
#
# This copies pre-generated configs into the Basilisk checkout.
# Docker Compose will automatically merge the .yml files.
# MCP configs are merged automatically by ./basilisk up.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# basilisk beside this repo, or one level up when this repo sits in a
# gs/ or gw/ bucket and basilisk at the top of /projects (or the other way
# round).  Physical paths: reached through a top-level compat symlink,
# `..` resolves against the real parent, which is how balaram's first
# bucketed deploy (2026-09-16) looked for gs/basilisk and found nothing.
if [ -z "${BASILISK_DIR:-}" ]; then
    for d in "$SCRIPT_DIR/../basilisk" "$SCRIPT_DIR/../../basilisk" \
             "$SCRIPT_DIR/../gs/basilisk" "$SCRIPT_DIR/../../gs/basilisk" \
             "$SCRIPT_DIR/../gw/basilisk" "$SCRIPT_DIR/../../gw/basilisk"; do
        [ -d "$d" ] && { BASILISK_DIR="$(cd "$d" && pwd -P)"; break; }
    done
fi
TARGET_DIR="${BASILISK_DIR:-$SCRIPT_DIR/../basilisk}"

echo "Installing cloud-stack..."
echo "  from: $SCRIPT_DIR"
echo "  into: $TARGET_DIR"
echo ""

# Check if target directory exists
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Target directory $TARGET_DIR does not exist"
    echo "Clone basilisk beside this repo, or set BASILISK_DIR."
    exit 1
fi

# Copy compose overlay
echo "Installing cloud-stack-compose.yml..."
cp "$SCRIPT_DIR/cloud-stack-compose.yml" "$TARGET_DIR/"

# Copy MCP configs
echo "Installing MCP configs..."
mkdir -p "$TARGET_DIR/mcp"
cp "$SCRIPT_DIR/mcp/cloud-stack-mcp-container.json" "$TARGET_DIR/mcp/"
cp "$SCRIPT_DIR/mcp/cloud-stack-mcp-windows.json" "$TARGET_DIR/mcp/"
cp "$SCRIPT_DIR/mcp/cloud-stack-mcp.toml" "$TARGET_DIR/mcp/"

# Copy services discovery (dashboard + swank)
echo "Installing services discovery..."
mkdir -p "$TARGET_DIR/generated"
for svc_file in "$SCRIPT_DIR/generated/"*-services-generated.el; do
    if [ -f "$svc_file" ]; then
        cp "$svc_file" "$TARGET_DIR/generated/"
    fi
done

if [ -f "$SCRIPT_DIR/generated/cloud-stack-crew.env" ]; then
    echo "Installing crew ledger (generated/cloud-stack-crew.env)..."
    mkdir -p "$TARGET_DIR/generated"
    cp "$SCRIPT_DIR/generated/cloud-stack-crew.env" "$TARGET_DIR/generated/cloud-stack-crew.env"
fi

if [ -f "$SCRIPT_DIR/generated/cloud-stack-chart-locker.tsv" ]; then
    echo "Installing the chart locker manifest (generated/cloud-stack-chart-locker.tsv)..."
    mkdir -p "$TARGET_DIR/generated"
    cp "$SCRIPT_DIR/generated/cloud-stack-chart-locker.tsv" "$TARGET_DIR/generated/cloud-stack-chart-locker.tsv"
fi

# --- systemd host injection ------------------------------------
echo "Injecting systemd host.env (image variant: lite)..."
mkdir -p "$TARGET_DIR/systemd"
{
  echo "# Generated by cloud-stack/install -- do not edit."
  echo "# Read by basilisk.service via EnvironmentFile."
  echo "EMACS_IMAGE_VARIANT=lite"
} > "$TARGET_DIR/systemd/host.env"
echo "  wrote $TARGET_DIR/systemd/host.env"
echo "  install/refresh the units with: (cd $TARGET_DIR && sh systemd/install)"

echo ""
echo "Installation complete!"
echo ""