#!/bin/bash
# hangar-init -- PID 1's charge in the hangar room: the FLEET LOOP.  It
# reads the lab's deployed root at /deployments, raises a microVM per
# deployed web application (hosted up, a port of the hangar's own per
# VM), takes a VM down while the gate says its hosting is stopped and
# brings it back when hosting is added, takes it down for good when the
# deployment is gone -- and REGISTERS every host with the ship's
# cyclops (the admin door /_cyclops/hangar/vms), whose :hangar rule
# routes <name>.$APPS_DOMAIN to the VM, a paused host to the proxy's own
# paused page, and any other host on to the lab.  The hangar routes
# nothing itself.  /run/hangar/status.json says what flies and
# /run/hangar/alive is touched every pass (the room's health check).
#
# Environment: FC_DIR (/fc: the hosted rootfs from hangar/make-rootfs,
# the data disks, the run directory), DEPLOYMENTS (/deployments),
# APPS_DOMAIN (gen.works), GATE_URL (the gate's Messages door), LAB
# (the lab's name at the gate, its *lab-name*), CYCLOPS_ADMIN_URL
# (http://transporter-room/_cyclops) and CYCLOPS_ADMIN_SECRET (the
# chief's admin secret; without it nothing is registered and the loop
# says so), HANGAR_INTERVAL (15 s), VCPUS and MEM_MIB per VM (hosted's
# defaults), HANGAR_FEED_URL and HANGAR_FEED_TOKEN_FILE (the lab's feed
# doors and the token that opens them; unset, /deployments is read as
# mounted), HANGAR_ENGINE (gendl, or solid: the engine whose rootfs this
# hangar flies), HANGAR_MAX_VMS (0: no limit but the room's memory cap; a
# dev ship says 2 -- the rest wait, and fly as others are grounded),
# HANGAR_SNAPSHOT (1: the engine's TEMPLATE is booted once, the lab loaded,
# and snapshotted -- again whenever the rootfs is newer -- and every VM is
# a clone restored from it in about a second; 0: every VM boots cold),
# HANGAR_RETIRE_DAYS and HANGAR_STOPPED_DAYS (30 and 30: see THE UN-HOSTING
# RULE below).
#
# THE UN-HOSTING RULE, for a deployment taken down at the lab (undeployed,
# or gone from the deployed root): its VM goes, and its data disk -- the
# app's purses, grants and workspace -- is RETIRED at once, moved out of the
# live name to $FC_DIR/retired/<name>.<epoch>/ with its records extracted
# beside it as plain files (tree/).  The lab frees the name on undeploy, so a
# disk left under it would hand the old app's files and its visitors'
# purses to whoever deploys the name next.  If the SAME author (the record's
# owner) deploys the name again within HANGAR_RETIRE_DAYS, the newest
# retired disk comes back, the new record and model written onto it; anyone
# else gets a fresh disk.  After HANGAR_RETIRE_DAYS the disk image is
# removed and the extracted records are kept for good (a few KB: what
# visitors held in purses is a claim worth keeping).  Nothing is retired on
# a pass that could not read the deployed root (the feed down).
#
# Its other half, for a deployment whose hosting is STOPPED at the gate
# (its allowance and what was bought for it spent): the VM is grounded and
# the proxy's paused page stands in, the deployment keeps its name, and
# once the gate's stopped_since is HANGAR_STOPPED_DAYS old its disk is
# retired the same way -- the same author's again when hosting is added
# within HANGAR_RETIRE_DAYS of that, its records kept for good after.  (The
# gate lifts a stop from an earlier month when the new month brings a free
# allowance, so a free-tier application comes back each month rather than
# counting toward retirement.)
#
# PRIVATE SESSIONS (the trust ladder's rung 2): the private front (demos
# private.lisp, on a lab room of this ship) writes a request into
# $FC_DIR/spool/requests/<id>.json -- {id pl-<10 hex>, wallet, token} --
# once the gate says the author's standing opens private sessions.  The
# loop raises a VM for it restored from the engine's snapshot and activated
# as a session (hosted up, MODE=session: the whole lab, behind the token),
# registers <id>.$APPS_DOMAIN with the chief, and answers in
# spool/ready/<id>.json ({state up|failed|ended, host, reason}), which the
# front reads.  The author's work lives on ONE disk per author
# ($FC_DIR/authors/<hash of the wallet>.data.ext4, hard-linked as the VM's
# own while it flies), so their private archive carries over from session
# to session; one session per author at a time.  A session ends when its
# lab has been idle HANGAR_SESSION_IDLE (7200 s), has flown
# HANGAR_SESSION_MAX (43200 s), or its request is withdrawn; at most
# HANGAR_MAX_SESSIONS (4) fly at once, the rest wait.  HANGAR_SESSION_LAB
# (prompt-lab-private) is their lab's name at the gate.
#
# THE MONETIZING RUNG: a request the front marks "monetize" (the author's
# standing at the gate is monetizing) opens with Monetize, its deploys
# handed to the front's session doors at HANGAR_FRONT_URL (as the VMs reach
# them: through the ship's proxy, never a room's own port).  The front
# keeps those deployments in the PRIVATE DEPLOYED ROOT, $FC_DIR/private-
# deployed/<engine>/<name>/ (HANGAR_PRIVATE_ROOT; the front's room mounts
# it), and this loop flies that root beside the feed, each of its apps at
# <name>.$APPS_DOMAIN under the private lab's name (HANGAR_SESSION_LAB),
# which is also the name the front keeps its books under.  A name the feed
# holds is the feed's: the loop writes the feed's names to
# spool/feed-names.json every pass, and the front refuses them.  A private
# deployment deployed again (its files' dates and sizes changed) is
# refreshed as a feed's is.
#
# HANGAR_EGRESS (gate): what a VM may reach -- the gate, and for a session
# the front, and nothing else; open: whatever the hangar reaches (hosted).
set -u
FC_DIR=${FC_DIR:-/fc}; DEPLOYMENTS=${DEPLOYMENTS:-/deployments}
APPS_DOMAIN=${APPS_DOMAIN:-gen.works}; GATE_URL=${GATE_URL:-http://transporter-room/llm/messages}
LAB=${LAB:-prompt-lab}; INTERVAL=${HANGAR_INTERVAL:-15}; ENGINE=${HANGAR_ENGINE:-gendl}
MAX_VMS=${HANGAR_MAX_VMS:-0}   # 0: as many as the room's memory cap allows; a dev ship says 2
SNAPSHOT=${HANGAR_SNAPSHOT:-1}
RETIRE_DAYS=${HANGAR_RETIRE_DAYS:-30}; STOPPED_DAYS=${HANGAR_STOPPED_DAYS:-30}
SPOOL=$FC_DIR/spool; MAX_SESSIONS=${HANGAR_MAX_SESSIONS:-4}
SESSION_IDLE=${HANGAR_SESSION_IDLE:-7200}; SESSION_MAX=${HANGAR_SESSION_MAX:-43200}
SESSION_LAB=${HANGAR_SESSION_LAB:-prompt-lab-private}
PRIVATE_ROOT=${HANGAR_PRIVATE_ROOT:-$FC_DIR/private-deployed}; FRONT_URL=${HANGAR_FRONT_URL:-}
EGRESS=${HANGAR_EGRESS:-gate}; export EGRESS
ADMIN_URL=${CYCLOPS_ADMIN_URL:-http://transporter-room/_cyclops}; ADMIN_SECRET=${CYCLOPS_ADMIN_SECRET:-}
# THE FEED: a lab elsewhere serves its deployed root to this hangar
# (demos deploy.lisp, <prefix>/api/hangar/deployments and /deployment,
# behind a token); mirrored into $FC_DIR/feed, which is then the
# deployed root read below.  Unset: /deployments is read as mounted.
FEED_URL=${HANGAR_FEED_URL:-}; FEED_TOKEN_FILE=${HANGAR_FEED_TOKEN_FILE:-/run/secrets/hangar-token}
HOSTED=/usr/local/lib/hangar/hosted
# the scripts baked into this image, hashed: hangar/scripts-hash on the host
# hashes the checkout's the same way, so a room raised on a stale image shows
scripts_hash() { (cd /usr/local/lib/hangar && cat hangar-init hosted guest-init hosted-services-init.cl build-rootfs) 2>/dev/null | sha256sum | cut -c1-12; }
SCRIPTS=$(scripts_hash)
export FC_DIR GATE_URL LAB ENGINE
run=$FC_DIR/run; mkdir -p "$run" /run/hangar
log() { echo "$(date -u +%FT%TZ) hangar: $*"; }

# --- the chief's table -------------------------------------------------------
register() {   # register NAME STATE [PORT] [TITLE]: tell the proxy where NAME's host goes
    local name=$1 state=$2 port=${3:-} title=${4:-$1} body
    [ -n "$ADMIN_SECRET" ] || return 0
    body=$(jq -cn --arg n "$name" --arg h "$name.$APPS_DOMAIN" --arg b "${port:+hangar:$port}" --arg s "$state" --arg t "$title" \
              '{name:$n, host:$h, backend:$b, state:$s, title:$t}')
    curl -s --max-time 5 -X POST -H "X-Cyclops-Admin-Secret: $ADMIN_SECRET" -H 'Content-Type: application/json' \
         -d "$body" "$ADMIN_URL/hangar/vms" >/dev/null \
        || log "$name: the chief did not take the registration ($ADMIN_URL)"
}

# --- the feed ----------------------------------------------------------------
feed_sync() {   # mirror the lab's deployments into $FC_DIR/feed/<engine>/<name>/; 0 when the list was read
    local token list engine row name stamp old dir detail seen="" d
    token=$(head -1 "$FEED_TOKEN_FILE" 2>/dev/null | tr -d ' \r')
    if [ -z "$token" ]; then
        [ -f "$run/.feed-warned" ] || { log "no token at $FEED_TOKEN_FILE: the feed cannot be read"; touch "$run/.feed-warned"; }
        return 1
    fi
    list=$(curl -s --max-time 15 -H "X-Prompt-Lab-Hangar: $token" "$FEED_URL/deployments") || { log "the feed at $FEED_URL did not answer"; return 1; }
    engine=$(jq -r '.engine // empty' <<<"$list" 2>/dev/null)
    if [ -z "$engine" ]; then
        [ -f "$run/.feed-warned" ] || { log "the feed answered no list: $(head -c 160 <<<"$list")"; touch "$run/.feed-warned"; }
        return 1
    fi
    rm -f "$run/.feed-warned"
    mkdir -p "$FC_DIR/feed/$engine"
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        name=$(jq -r .name <<<"$row"); stamp=$(jq -r .stamp <<<"$row")
        [ -n "$name" ] && [ "$name" != null ] || continue
        seen="$seen $name"; dir=$FC_DIR/feed/$engine/$name
        old=$(cat "$dir/.stamp" 2>/dev/null || true)
        [ "$old" = "$stamp" ] && continue
        detail=$(curl -s --max-time 30 -H "X-Prompt-Lab-Hangar: $token" "$FEED_URL/deployment?name=$name") || { log "$name: the feed did not give it"; continue; }
        jq -e '.record and .model' <<<"$detail" >/dev/null 2>&1 || { log "$name: the feed gave no record"; continue; }
        mkdir -p "$dir"
        jq -c .record <<<"$detail" > "$dir/deployment.json"
        jq -r .model <<<"$detail" > "$dir/model.lisp"
        echo "$stamp" > "$dir/.stamp"
        if [ -n "$old" ]; then touch "$run/$name.refresh"; log "$name: deployed again at the lab; its VM takes the new files"; else log "$name: new from the lab's feed"; fi
    done < <(jq -c '.deployments[]' <<<"$list" 2>/dev/null)
    for d in "$FC_DIR/feed/$engine"/*/; do
        [ -d "$d" ] || continue
        name=$(basename "$d")
        case " $seen " in *" $name "*) ;; *) rm -rf "$d"; log "$name: gone from the lab's feed" ;; esac
    done
    return 0
}

refresh_disk() {   # refresh_disk NAME DIR ENGINE: the deployment's new files into its existing data disk (no mount: debugfs)
    local name=$1 dir=$2 engine=$3 disk=$FC_DIR/$name.data.ext4 path=/prompt-lab-deployed/$engine/$name f want got
    [ -f "$disk" ] || return 0
    # the guest was killed, not unmounted: its journal is dirty, and the
    # next boot would replay it OVER anything written here -- replay it first
    e2fsck -fy "$disk" >/dev/null 2>&1 || true
    for f in deployment.json model.lisp; do
        debugfs -w -R "rm $path/$f" "$disk" >/dev/null 2>&1 || true
        debugfs -w -R "write $dir/$f $path/$f" "$disk" >/dev/null 2>&1 || true
        # the uid the guest's service runs as (the image's user, 1000), as hosted disk sets it
        debugfs -w -R "set_inode_field $path/$f uid 1000" "$disk" >/dev/null 2>&1 || true
        debugfs -w -R "set_inode_field $path/$f gid 1000" "$disk" >/dev/null 2>&1 || true
        want=$(stat -c %s "$dir/$f"); got=$(debugfs -R "stat $path/$f" "$disk" 2>/dev/null | sed -n 's/.*Size: \([0-9]*\).*/\1/p' | head -1)
        [ "$want" = "$got" ] || log "$name: $f did not go onto the disk (size $got, wanted $want)"
    done
}

vm_gone() {   # vm_gone PID: wait for a VM's process to leave (its disk is ours to edit then)
    local pid=$1 i
    [ -n "$pid" ] || return 0
    for i in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.2; done
    log "a VM (pid $pid) is slow to leave"
}

# --- the template --------------------------------------------------------------
rootfs() { if [ "$ENGINE" = gendl ]; then echo "$FC_DIR/hosted.ext4"; else echo "$FC_DIR/hosted-$ENGINE.ext4"; fi; }
template() {   # the engine's snapshot, made when missing or older than the rootfs
    [ "$SNAPSHOT" = 1 ] || return 0
    $HOSTED fresh "$ENGINE" && return 0
    # one try per rootfs: a template that failed waits for a new one
    local mark; mark=$(stat -c %Y "$(rootfs)")
    [ "$(cat "$run/.template-failed" 2>/dev/null)" = "$mark" ] && return 0
    # the template takes a VM's memory while it loads: not while the hangar is full
    if [ "$MAX_VMS" -gt 0 ] && [ "$(vms_running)" -ge "$MAX_VMS" ]; then
        [ -f "$run/.template-waiting" ] || { log "the $ENGINE snapshot is stale; the hangar is full, so it waits"; touch "$run/.template-waiting"; }
        return 0
    fi
    rm -f "$run/.template-waiting"
    log "making the $ENGINE template and its snapshot (VMs boot cold until it is there)"
    if $HOSTED template "$ENGINE" 2>&1 | sed 's/^/  /' && $HOSTED fresh "$ENGINE"; then
        rm -f "$run/.template-failed"; log "the $ENGINE snapshot is made: VMs are restored from it"
    else
        echo "$mark" > "$run/.template-failed"; log "the $ENGINE template failed; VMs boot cold until the rootfs is made again"
    fi
}

# --- the fleet ---------------------------------------------------------------
next_port() {   # a port of the hangar's own per VM (hosted's DNAT wants them distinct)
    local f=$run/next-port n; n=$(cat "$f" 2>/dev/null || echo 9080); echo $((n+1)) > "$f"; echo "$n"
}
vm_running() { [ -f "$run/$1.pid" ] && kill -0 "$(cat "$run/$1.pid")" 2>/dev/null; }
vms_running() { local n=0 f; for f in "$run"/*.pid; do [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && n=$((n+1)); done; echo $n; }
gate_hosting() {   # gate_hosting NAME [LAB] [RECORD] -> 'true SINCE' (SINCE the stop, unix seconds) | false | '' (no answer)
    # the deployment's key from its RECORD (deployment.json's gate_key): a gate
    # that registers keys answers a keyed deployment's hosting to that key alone
    local key=''
    [ -n "${3:-}" ] && key=$(jq -r '.gate_key // empty' "$3" 2>/dev/null)
    # the gate's stopped_since is a Lisp universal time: seconds since 1900
    jq -nc --arg lab "${2:-$LAB}" --arg name "$1" --arg key "$key" \
       '{lab: $lab, deployment: $name} + (if $key == "" then {} else {deployment_key: $key} end)' \
        | curl -s --max-time 5 -X POST -H 'Content-Type: application/json' --data-binary @- "$GATE_URL/host-balance" \
        | jq -r 'if .stopped == true then "true \((.stopped_since // 0) - 2208988800)" else "false" end' 2>/dev/null
}
days_seconds() { awk -v days="$1" 'BEGIN{printf "%d", days*86400}'; }
status_json() {
    local tmp=/run/hangar/status.json.new first=1 f name
    {
        echo "{\"rootfs\": $([ -f "$(rootfs)" ] && echo true || echo false), \"engine\": \"$ENGINE\", \"scripts\": \"$SCRIPTS\", \"snapshot\": $($HOSTED fresh "$ENGINE" && echo true || echo false), \"lab\": \"$LAB\", \"session_lab\": \"$SESSION_LAB\", \"front\": $([ -n "$FRONT_URL" ] && echo true || echo false), \"egress\": \"$EGRESS\", \"domain\": \"$APPS_DOMAIN\", \"registering\": $([ -n "$ADMIN_SECRET" ] && echo true || echo false), \"vms\": ["
        for f in "$run"/*.pid; do
            [ -f "$f" ] || continue; name=$(basename "$f" .pid)
            case $name in tpl-*) continue ;; esac
            [ $first = 1 ] || echo ','; first=0
            printf '{"name": "%s", "host": "%s.%s", "up": %s, "port": %s}' "$name" "$name" "$APPS_DOMAIN" "$(vm_running "$name" && echo true || echo false)" "$(cat "$run/$name.port" 2>/dev/null || echo 0)"
        done
        for f in "$run"/*.paused; do
            [ -f "$f" ] || continue; name=$(basename "$f" .paused)
            [ $first = 1 ] || echo ','; first=0
            printf '{"name": "%s", "host": "%s.%s", "up": false, "paused": true}' "$name" "$name" "$APPS_DOMAIN"
        done
        echo '], "at": "'"$(date -u +%FT%TZ)"'"}'
    } > "$tmp" && mv "$tmp" /run/hangar/status.json
    touch /run/hangar/alive
}

# --- the un-hosting rule (the header says what and why) ------------------------
retired_dir() { echo "$FC_DIR/retired"; }
# owner_of DEPLOYMENT-JSON: who the deployment is the author's -- a private
# deployment's author key (one author, many sessions), else its owner key
owner_of() { jq -r '.author // .owner // empty' "$1" 2>/dev/null; }

retire_disk() {   # retire_disk NAME [WHY]: its disk out of the live name, its records extracted beside it
    local name=$1 why=${2:-taken down at the lab} disk=$FC_DIR/$1.data.ext4 at d top
    [ -f "$disk" ] || return 0
    at=$(date +%s); d=$(retired_dir)/$name.$at; mkdir -p "$d/tree"
    # the guest was killed, not unmounted: replay its journal before reading the tree
    e2fsck -fy "$disk" >/dev/null 2>&1 || true
    for top in prompt-lab-deployed prompt-lab; do debugfs -R "rdump /$top $d/tree" "$disk" >/dev/null 2>&1 || true; done
    mv "$disk" "$d/data.ext4"; echo "$at" > "$d/since"
    log "$name: $why; its disk retired to $d ($RETIRE_DAYS days to come back to its author; its records kept for good)"
}

revive_disk() {   # revive_disk NAME DIR: the newest retired disk of NAME's back, when DIR's owner is its owner -> 0
    local name=$1 dir=$2 owner d best="" at best_at=0 was
    owner=$(owner_of "$dir/deployment.json"); [ -n "$owner" ] || return 1
    for d in "$(retired_dir)/$name".*/; do
        [ -f "$d/data.ext4" ] || continue
        at=${d%/}; at=${at##*.}; case $at in *[!0-9]*|'') continue ;; esac
        was=$(owner_of "$(ls "$d"tree/prompt-lab-deployed/*/"$name"/deployment.json 2>/dev/null | head -1)")
        [ "$was" = "$owner" ] && [ "$at" -gt "$best_at" ] && { best=${d%/}; best_at=$at; }
    done
    [ -n "$best" ] || return 1
    mv "$best/data.ext4" "$FC_DIR/$name.data.ext4"; rm -rf "$best"
    log "$name: back with its author (deployed again, or hosting added); the disk retired $(date -u -d "@$best_at" +%FT%TZ) is back, its purses and grants with it"
}

expire_retired() {   # retired disks past RETIRE_DAYS go; their extracted records stay
    local d since now limit; now=$(date +%s)
    limit=$(awk -v days="$RETIRE_DAYS" 'BEGIN{printf "%d", days*86400}')
    for d in "$(retired_dir)"/*/; do
        [ -f "$d/data.ext4" ] || continue
        since=$(cat "$d/since" 2>/dev/null || echo "$now")
        [ $(( now - since )) -ge "$limit" ] || continue
        rm -f "$d/data.ext4"; date -u +%FT%TZ > "$d/disk-removed"
        log "$(basename "$d"): retired $RETIRE_DAYS days; its disk removed, its records kept in ${d}tree"
    done
}

# --- private sessions (the header says what and why) --------------------------
session_prefix() { if [ "$ENGINE" = solid ]; then echo /prompt-lab/solid; else echo /prompt-lab; fi; }
session_gport() { if [ "$ENGINE" = solid ]; then echo 9088; else echo 9080; fi; }
sessions_running() { local n=0 f; for f in "$run"/pl-*.pid; do [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && n=$((n+1)); done; echo $n; }
author_disk() { echo "$FC_DIR/authors/$(printf '%s' "$1" | sha256sum | cut -c1-16).data.ext4"; }   # author_disk WALLET
session_answer() {   # session_answer ID STATE [REASON]: the front's word on the request
    local tmp=$SPOOL/ready/.$1.json
    jq -cn --arg id "$1" --arg s "$2" --arg r "${3:-}" --arg h "$1.$APPS_DOMAIN" \
       '{id:$id, state:$s, host:$h, reason:$r, at:(now|floor)}' > "$tmp" && chmod 644 "$tmp" && mv "$tmp" "$SPOOL/ready/$1.json"
}
session_end() {   # session_end ID WHY: the VM down, the author's disk kept, the host gone
    local id=$1 why=$2 pid; pid=$(cat "$run/$id.pid" 2>/dev/null || true)
    $HOSTED down "$id" >/dev/null 2>&1 || true; vm_gone "$pid"
    register "$id" gone
    rm -f "$FC_DIR/$id.data.ext4" "$run/$id.wallet"      # the link; the author's disk stays
    session_answer "$id" ended "$why"; rm -f "$SPOOL/requests/$id.json"
    log "$id: the private session ended ($why)"
}

sessions() {   # one pass over the private sessions' spool
    [ -d "$SPOOL/requests" ] || return 0
    local f id wallet token port disk other idle busy age why answer mon front
    for f in "$SPOOL/requests"/*.json; do
        [ -f "$f" ] || continue
        id=$(jq -r '.id // empty' "$f" 2>/dev/null); wallet=$(jq -r '.wallet // empty' "$f" 2>/dev/null); token=$(jq -r '.token // empty' "$f" 2>/dev/null)
        # the monetizing rung: deploys through the front, when this hangar knows where it is
        mon=0; front=""
        if [ "$(jq -r '.monetize // false' "$f" 2>/dev/null)" = true ] && [ -n "$FRONT_URL" ]; then mon=1; front=$FRONT_URL; fi
        if ! [[ $id =~ ^pl-[0-9a-f]{10}$ && $wallet =~ ^[0-9a-f]{24}$ && $token =~ ^[0-9a-f]{32}$ && $(basename "$f" .json) = "$id" ]]; then
            log "a malformed session request ($(basename "$f")) dropped"; rm -f "$f"; continue
        fi
        [ -f "$SPOOL/ready/$id.json" ] && continue          # answered already
        vm_running "$id" && continue
        # one session per author: their disk cannot be mounted twice
        other=$(grep -lx "$wallet" "$run"/pl-*.wallet 2>/dev/null | head -1)
        if [ -n "$other" ]; then
            session_answer "$id" failed "this author has a private session open already: $(basename "$other" .wallet)"; continue
        fi
        if [ "$(sessions_running)" -ge "$MAX_SESSIONS" ]; then
            [ -f "$run/$id.waiting" ] || { log "$id: the hangar holds $MAX_SESSIONS private sessions; waiting"; touch "$run/$id.waiting"; }
            continue
        fi
        rm -f "$run/$id.waiting"
        disk=$(author_disk "$wallet"); mkdir -p "$FC_DIR/authors"
        if [ ! -f "$disk" ]; then
            $HOSTED blank "au-$id" >/dev/null && mv "$FC_DIR/au-$id.data.ext4" "$disk" && log "$id: a new author's disk"
        fi
        ln -f "$disk" "$FC_DIR/$id.data.ext4"; echo "$wallet" > "$run/$id.wallet"
        port=$(next_port)
        log "$id: a private session$([ "$mon" = 1 ] && echo ' with Monetize'); raising its VM on :$port"
        local out rc; out=$(MODE=session TOKEN=$token LAB=$SESSION_LAB MONETIZE=$mon FRONT=$front $HOSTED up "$id" "$port" 2>&1); rc=$?
        [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/  /'
        if [ "$rc" = 0 ] && vm_running "$id"; then
            register "$id" up "$port" "A private session"
            session_answer "$id" up
        else
            session_end "$id" "its VM did not come up"; session_answer "$id" failed "its VM did not come up"
        fi
    done
    for f in "$run"/pl-*.pid; do
        [ -f "$f" ] || continue; id=$(basename "$f" .pid)
        vm_running "$id" || continue
        register "$id" up "$(cat "$run/$id.port")" "A private session"   # every pass, as the deployments' are
        answer=$(curl -s --max-time 3 "http://$($HOSTED ip "$id"):$(session_gport)$(session_prefix)/api/vm-idle")
        idle=$(jq -r '.idle // empty' <<<"$answer" 2>/dev/null); busy=$(jq -r '.busy // false' <<<"$answer" 2>/dev/null)
        age=$(( $(date +%s) - $(stat -c %Y "$f") )); why=""
        [ -f "$SPOOL/requests/$id.json" ] || why="its request was withdrawn"
        [ -n "$idle" ] && [ "$busy" != true ] && [ "$idle" -ge "$SESSION_IDLE" ] && why="idle $idle s"
        [ "$age" -ge "$SESSION_MAX" ] && why="open $age s, the longest a session flies"
        [ -z "$why" ] || session_end "$id" "$why"
    done
}

feed_names() {   # the names the feed (or the mounted root) holds, for the front: spool/feed-names.json
    local tmp=$SPOOL/.feed-names.json d
    [ -d "$SPOOL" ] || return 0
    for d in "$DEPLOYMENTS"/*/*/; do [ -d "$d" ] && basename "$d"; done | jq -R . | jq -sc . > "$tmp" \
        && chmod 644 "$tmp" && mv "$tmp" "$SPOOL/feed-names.json"
}

private_stamp() {   # private_stamp DIR: a private deployment deployed again since the last pass is marked for refresh
    local dir=$1 name stamp old f
    name=$(basename "$dir"); f=$FC_DIR/private-stamps/$name
    stamp=$(stat -c '%Y.%s' "$dir/deployment.json" "$dir/model.lisp" 2>/dev/null | tr '\n' ' ')
    old=$(cat "$f" 2>/dev/null || true)
    [ "$old" = "$stamp" ] && return 0
    if [ -n "$old" ]; then touch "$run/$name.refresh"; log "$name: deployed again from a private session; its VM takes the new files"
    else log "$name: new in the private deployed root"; fi
    echo "$stamp" > "$f"
}

fleet() {   # one pass over the deployed root and the private deployed root
    local dir name f
    SEEN=""
    for dir in "$DEPLOYMENTS"/*/*/; do
        [ -f "$dir/deployment.json" ] || continue
        fleet_one "$dir" "$LAB"
    done
    for dir in "$PRIVATE_ROOT"/*/*/; do
        [ -f "$dir/deployment.json" ] || continue
        name=$(basename "$dir")
        # a name the feed holds is the feed's (the front refuses it; this is the backstop)
        case " $SEEN " in *" $name "*)
            [ -f "$run/$name.clash" ] || { log "$name: in the private root AND the feed; the feed's flies"; touch "$run/$name.clash"; }
            continue ;;
        esac
        private_stamp "$dir"
        fleet_one "$dir" "$SESSION_LAB"
    done
    # private deployments gone: their stamps go with them
    for f in "$FC_DIR"/private-stamps/*; do
        [ -f "$f" ] || continue; name=$(basename "$f")
        [ -f "$PRIVATE_ROOT/$ENGINE/$name/deployment.json" ] || rm -f "$f" "$run/$name.clash"
    done
    fleet_gone
}

fleet_one() {   # fleet_one DIR LAB: one deployment, flown under LAB (the name its ledgers are kept by at the gate)
    local dir=$1 lab=$2 name kind engine title hosting stopped since port
    name=$(basename "$dir"); engine=$(basename "$(dirname "$dir")")
    kind=$(jq -r '.kind // "model"' "$dir/deployment.json" 2>/dev/null)
    title=$(jq -r '.title // .name' "$dir/deployment.json" 2>/dev/null)
    [ "$kind" = app ] || return 0          # a model stays in the lab's own image
    [ "$engine" = "$ENGINE" ] || return 0  # one rootfs per engine; the other engine's wait
    SEEN="$SEEN $name"
    # deployed again at the lab: the VM comes down, its disk takes the new files, and it comes back below
    if [ -f "$run/$name.refresh" ]; then
        if vm_running "$name"; then
            local pid; pid=$(cat "$run/$name.pid")
            log "$name: grounding it for its new files"; $HOSTED down "$name" >/dev/null 2>&1 || true; vm_gone "$pid"
        fi
        refresh_disk "$name" "$dir" "$engine"; rm -f "$run/$name.refresh"
    fi
    hosting=$(gate_hosting "$name" "$lab" "$dir/deployment.json"); stopped=${hosting%% *}
    if [ "$stopped" = true ]; then
        if vm_running "$name"; then
            log "$name: hosting stopped at the gate; taking its VM down"
            local stop_pid; stop_pid=$(cat "$run/$name.pid" 2>/dev/null || true)
            $HOSTED down "$name" >/dev/null 2>&1 || true; vm_gone "$stop_pid"
        fi
        touch "$run/$name.paused"
        register "$name" paused "" "$title"
        # the other half of the un-hosting rule: stopped HANGAR_STOPPED_DAYS, the disk retires
        since=${hosting#* }
        case $since in ''|*[!0-9]*) since=0 ;; esac
        if [ "$since" -gt 0 ] && [ -f "$FC_DIR/$name.data.ext4" ] \
           && [ $(( $(date +%s) - since )) -ge "$(days_seconds "$STOPPED_DAYS")" ]; then
            retire_disk "$name" "hosting stopped at the gate since $(date -u -d "@$since" +%F), $STOPPED_DAYS days or more"
        fi
        return 0
    fi
    rm -f "$run/$name.paused"
    if ! vm_running "$name" && [ "$MAX_VMS" -gt 0 ] && [ "$(vms_running)" -ge "$MAX_VMS" ]; then
        [ -f "$run/$name.waiting" ] || { log "$name: the hangar is full ($MAX_VMS VMs); waiting"; touch "$run/$name.waiting"; }
        return 0
    fi
    rm -f "$run/$name.waiting"
    port=$(cat "$run/$name.port" 2>/dev/null || next_port)
    if vm_running "$name"; then register "$name" up "$port" "$title"; return 0; fi
    # no live disk: the author's own retired one back with the new files, else a fresh one
    if [ ! -f "$FC_DIR/$name.data.ext4" ]; then
        if revive_disk "$name" "$dir"; then refresh_disk "$name" "$dir" "$engine"
        else $HOSTED disk "$name" "$dir" 2>&1 | sed 's/^/  /'; fi
    fi
    log "$name: raising its VM on :$port$([ "$lab" = "$LAB" ] || echo " (lab $lab)")"
    # its status, not sed's: a raise that died while its VM lived counted as up
    local out rc; out=$(LAB=$lab $HOSTED up "$name" "$port" 2>&1); rc=$?; [ -z "$out" ] || printf '%s\n' "$out" | sed 's/^/  /'
    if [ "$rc" = 0 ] && vm_running "$name"; then
        register "$name" up "$port" "$title"
    else
        log "$name: the VM did not come up"; $HOSTED down "$name" >/dev/null 2>&1 || true
    fi
}

fleet_gone() {   # the deployments no root holds any more: VMs down, disks retired (SEEN: what this pass flew)
    local f name
    # deployments taken down: their VMs go, and (below) their disks are retired
    for f in "$run"/*.pid "$run"/*.paused; do
        [ -f "$f" ] || continue
        name=$(basename "$f"); name=${name%.pid}; name=${name%.paused}
        case $name in tpl-*|pl-*) continue ;; esac     # a template being made, a private session: not a deployment's VM
        case " $SEEN " in *" $name "*) ;; *)
            log "$name: no longer deployed; its VM goes"
            local gone_pid; gone_pid=$(cat "$run/$name.pid" 2>/dev/null || true)
            $HOSTED down "$name" >/dev/null 2>&1 || true; rm -f "$run/$name.paused"; vm_gone "$gone_pid"
            register "$name" gone ;;
        esac
    done
    # THE UN-HOSTING RULE: a live disk whose deployment is gone is retired --
    # only on a pass that read the deployed root, so a feed outage retires nothing
    if [ "$ROOT_OK" = 1 ]; then
        for f in "$FC_DIR"/*.data.ext4; do
            [ -f "$f" ] || continue
            name=$(basename "$f" .data.ext4)
            case $name in pl-*|au-*) continue ;; esac      # a private session's link to its author's disk
            case " $SEEN " in *" $name "*) continue ;; esac
            vm_running "$name" && continue
            retire_disk "$name"
        done
    fi
    expire_retired
}

trap 'log "stopping: every VM down"; for f in "$run"/*.pid; do [ -f "$f" ] && { n=$(basename "$f" .pid); $HOSTED down "$n"; register "$n" gone; }; done; exit 0' TERM INT
log "hangar up: scripts $SCRIPTS, lab $LAB, gate $GATE_URL, hosts *.$APPS_DOMAIN, deployments $DEPLOYMENTS, engine $ENGINE, chief $ADMIN_URL, egress $EGRESS"
log "private sessions: lab $SESSION_LAB, deployed root $PRIVATE_ROOT, front ${FRONT_URL:-(none: no session deploys)}"
[ -r /dev/kvm ] || log "WARNING: /dev/kvm is not here; no VM can fly"
[ -n "$ADMIN_SECRET" ] || log "WARNING: no CYCLOPS_ADMIN_SECRET; the VMs fly unregistered and no host reaches them"
# a fresh room: nothing from a previous life is running, and the ports are
# the room's to give out again (a stale port file once put two VMs on one)
rm -f "$run"/*.pid "$run"/*.sock "$run"/*.port "$run"/*.engine "$run"/*.paused "$run"/*.waiting "$run"/*.wallet "$run"/next-port "$run"/.template-* "$run"/.rootfs-warned
# the private sessions' spool, written by the front's room (another user): sessions
# that were flying when the room went down are over, their links to authors' disks with them
mkdir -p "$SPOOL/requests" "$SPOOL/ready" && chmod 1777 "$SPOOL" "$SPOOL/requests" "$SPOOL/ready"
# the private deployed root, written by the front's room too (its books with it)
mkdir -p "$PRIVATE_ROOT" "$FC_DIR/private-stamps" && chmod 1777 "$PRIVATE_ROOT"
for f in "$SPOOL/ready"/pl-*.json; do
    [ -f "$f" ] && [ "$(jq -r .state "$f" 2>/dev/null)" = up ] || continue
    id=$(basename "$f" .json); rm -f "$FC_DIR/$id.data.ext4" "$SPOOL/requests/$id.json"
    session_answer "$id" ended "the hangar restarted"
done
ip link show 2>/dev/null | sed -n 's/^[0-9]*: \(tpl-[^:@]*\|host[0-9]*\)[:@].*/\1/p' | while read -r t; do ip link del "$t" 2>/dev/null; done
status_json
[ -n "$FEED_URL" ] && { DEPLOYMENTS=$FC_DIR/feed; log "the deployed root is the lab's feed at $FEED_URL, mirrored in $DEPLOYMENTS"; }
while :; do
    # whether this pass read the deployed root (the feed answered a list, or the mount is there)
    if [ -n "$FEED_URL" ]; then if feed_sync; then ROOT_OK=1; else ROOT_OK=0; fi
    elif [ -d "$DEPLOYMENTS" ]; then ROOT_OK=1; else ROOT_OK=0; fi
    [ "$ROOT_OK" = 1 ] && feed_names
    if [ -f "$(rootfs)" ]; then template; fleet; sessions
    else [ -f "$run/.rootfs-warned" ] || { log "no $(rootfs): make it with hangar/make-rootfs on the host"; touch "$run/.rootfs-warned"; }; fi
    status_json
    sleep "$INTERVAL" & wait $!
done
