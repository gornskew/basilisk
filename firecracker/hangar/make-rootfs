#!/bin/bash
# make-rootfs -- on the HOST, with docker: the hangar's hosted rootfs,
# FC_DIR/hosted.ext4 -- the Gendl image's filesystem plus the lab's
# checkouts (demos, monocle) at /opt/hosted and the hosted init.  Run
# it once per engine image, and again when the lab's code changes; the
# hangar's VMs boot from the result (a copy each).
#
#   hangar/make-rootfs [FC_DIR]
#
# Environment: GENDL_IMAGE (genworks/gendl:devo-ccl), DEMOS and MONOCLE
# (the checkouts; /projects/gw/demos and /projects/gw/monocle by
# default), SIZE (4G).  Needs about 5 GB under FC_DIR while it runs.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)      # the firecracker/ kit
FC_DIR=${1:-${FC_DIR:-$HOME/firecracker-phase0}}
GENDL_IMAGE=${GENDL_IMAGE:-genworks/gendl:devo-ccl}
# the lab's checkouts: given, or found in either layout -- the dev
# host's buckets (gw/demos, gw/monocle) or a production host's flat
# /projects (demos, monocle) -- under /projects or the home's projects
find_checkout() {   # find_checkout NAME [GIVEN]
    local name=$1 given=${2:-} d
    [ -n "$given" ] && [ -d "$given" ] && { echo "$given"; return; }
    for d in /projects/gw/$name /projects/$name "$HOME/projects/gw/$name" "$HOME/projects/$name"; do
        [ -d "$d" ] && { echo "$d"; return; }
    done
    echo "make-rootfs: no $name checkout found (set ${name^^}=/path; monocle clones from https://gitlab.common-lisp.net/clo/monocle.git)" >&2
    exit 1
}
DEMOS=$(find_checkout demos "${DEMOS:-}"); MONOCLE=$(find_checkout monocle "${MONOCLE:-}")
SIZE=${SIZE:-4G}
[ -w "$(dirname "$FC_DIR")" ] || [ -w "$FC_DIR" ] || { echo "make-rootfs: $FC_DIR is not writable by $(id -un); chown it (a raise may have made it root's) rather than running this under sudo" >&2; exit 1; }
mkdir -p "$FC_DIR/hosted"
echo "exporting $GENDL_IMAGE"
cid=$(docker create "$GENDL_IMAGE"); docker export "$cid" -o "$FC_DIR/gendl.tar"; docker rm "$cid" >/dev/null
echo "copying the lab's checkouts from $DEMOS and $MONOCLE"
rsync -a --delete --exclude .git --exclude '*.fasl' --exclude node_modules --exclude CLAUDE.md "$DEMOS/" "$FC_DIR/hosted/demos/"
rsync -a --delete --exclude .git --exclude '*.fasl' "$MONOCLE/" "$FC_DIR/hosted/monocle/"
echo "building $FC_DIR/hosted.ext4 ($SIZE)"
docker run --rm -v "$FC_DIR":/work -v "$here":/hangar:ro -v "$FC_DIR/hosted":/hosted:ro \
    debian:13-slim bash /hangar/hangar/build-rootfs hosted "$SIZE"
rm -f "$FC_DIR/gendl.tar"
echo "done: the hangar boots its VMs from $FC_DIR/hosted.ext4 (a running VM keeps its copy until it is raised again)"
