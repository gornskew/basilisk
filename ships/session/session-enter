# A session ship's console door: what every browser connection to the
# ship's ttyd runs.  ttyd -a hands the URL's ?arg= values through: $1 is
# the session's model file as the lab names it, $2 "newcomer" for the
# frame set up for someone new to Emacs.  Only the one pattern is opened;
# anything else opens the work directory.  The ship holds one session,
# so this is tidiness rather than a boundary.

[ "$2" = newcomer ] && export SKEWED_EMACS_NEWCOMER=1
target="${1:-}"
case "$target" in
  /state/prompt-lab/*/model.lisp)
    case "$target" in
      *[!a-z0-9/.-]*|*..*) target="" ;;
    esac ;;
  *) target="" ;;
esac
[ -n "$target" ] && [ -f "$target" ] && exec emacsclient -t "$target"
exec emacsclient -t /state/prompt-lab/
