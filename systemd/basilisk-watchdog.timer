# Every 5 minutes, starting 3 minutes after boot -- late enough that a cold
# box has finished pulling images and starting containers, so the first run
# does not mistake a slow start for a fault.
[Unit]
Description=Run the Basilisk watchdog periodically
Documentation=https://gitlab.genworks.com/gornskew/basilisk

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=basilisk-watchdog.service

[Install]
WantedBy=timers.target
